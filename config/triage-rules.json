{
  "push": {
    "diff": {
      "added": true,
      "removed": true
    },
    "errors": {
      "errorTypes": ["PageValidationError"],
      "phases": ["read_config", "write_state", "write_snapshot_log", "read_rules"],
      "consecutiveFetchFailures": 0,
      "repeatEscalation": {
        "windowSeconds": 1800,
        "threshold": 3
      }
    }
  },
  "suppress": {
    "isolatedRetryableError": true,
    "filenamePatterns": []
  },
  "unmatched": {
    "diff": "push",
    "error": "silent"
  },
  "semantic": {
    "enabled": false
  }
}