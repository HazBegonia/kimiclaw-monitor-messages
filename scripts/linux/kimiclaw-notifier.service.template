[Unit]
Description=Kimiclaw intranet notifier (resident, pushes via FF bot)
After=network-online.target kimiclaw-openclaw-gateway.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
ExecStart=@PYTHON@ -m src.intranet_notifier
Restart=always
RestartSec=11
Environment=PYTHONUNBUFFERED=1
Environment=PATH=@OPENCLAW_BIN_DIR@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
