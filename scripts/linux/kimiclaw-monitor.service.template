[Unit]
Description=Kimiclaw intranet filename monitor (resident)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
ExecStart=@PYTHON@ -m src.intranet_filename_monitor
Restart=always
RestartSec=11
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
