[Unit]
Description=Kimiclaw intranet filename monitor (resident)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/u504/kimiclaw-monitor-messages
ExecStart=/home/u504/anaconda3/envs/kimiclaw-monitor-messages/bin/python -m src.intranet_filename_monitor --interval 5 --timeout 10
Restart=always
RestartSec=11
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
