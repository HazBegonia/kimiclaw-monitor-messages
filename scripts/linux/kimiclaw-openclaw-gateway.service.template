[Unit]
Description=Kimiclaw OpenClaw gateway (Claw wecom channel, requirement intake)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@OPENCLAW_BIN_DIR@/openclaw gateway run
Restart=always
RestartSec=5
Environment=PATH=@OPENCLAW_BIN_DIR@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
